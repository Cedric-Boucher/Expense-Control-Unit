  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.id, c.name, c.is_asset, c.created_at, ch.parent_id as \"parent_id?\"\n        FROM categories c\n        LEFT JOIN category_hierarchy ch ON c.id = ch.category_id\n        WHERE c.user_id = $1\n        AND c.id = $2\n        ORDER BY c.id DESC\n        ",
