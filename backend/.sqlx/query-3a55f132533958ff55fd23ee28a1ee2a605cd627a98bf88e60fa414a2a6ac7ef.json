{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, t.name, t.created_at, t.closing_date\n        FROM tags t\n        JOIN transaction_tags tt ON t.id = tt.tag_id\n        WHERE tt.transaction_id = $1 AND t.user_id = $2\n        ORDER BY t.name ASC\n        ",
